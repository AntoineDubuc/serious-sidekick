# Secrets
.env
.env.*

# Credentials / keys (defense-in-depth)
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
*_rsa
*_dsa
*_ecdsa
*_ed25519
known_hosts
credentials.json
service-account*.json
secrets.*
*.secret
.aws/
.ssh/

# Python
.venv/
__pycache__/
*.pyc

# LinkedIn content
linkedin_article.md
linkedin_images/

# Personal images
cpap_*.png

# Downloaded installers / disk images (never part of the template)
*.dmg

# serious-update audit log (machine-generated, rewritten on every run)
update.log

# OS
.DS_Store
Thumbs.db

# Workflow breadcrumbs (active workflow tracking)
.active-*
.claude-active/

# Session context (personal, not for template consumers)
context.md

# Research artifacts (generated per-project, not part of the template)
Research/

# Diagnostic outcome logs (not a security control — see _shared/log-outcome.sh)
.claude/logs/*.log
.claude/logs/*.log.*

# Default-deny everything else under .claude/ (closes the class of "future files get tracked by default")
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/output-styles/
!.claude/CLAUDE.md

# Root-level research report dump from /serious-research deep mode
/report.html
