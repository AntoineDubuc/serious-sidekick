#!/bin/bash
# serious-update — Manifest-driven update system for Serious Sidekick
#
# Pulls latest from GitHub, reads manifest.json, distributes files
# to all global directories using ownership-tier logic.
#
# Usage: serious-update [--check|--diff|--rollback|--no-global|--help]
#
# Environment overrides (for testing):
#   SERIOUS_SIDEKICK_HOME  — override default ~/.serious-sidekick/
#   SERIOUS_TARGET_DIRS    — override default global dirs (space-separated)

set -euo pipefail

# --- Resolve script location and source shared library ---
# Try, in order, to find the repo root containing lib/serious-common.sh:
#   1. Walk symlinks via BASH_SOURCE (Linux/macOS canonical case)
#   2. SERIOUS_SIDEKICK_HOME env var (test override / non-default install)
#   3. $HOME/.serious-sidekick (the install.sh default)
#
# Git Bash on Windows doesn't create real symlinks — `ln -s` produces a file
# copy — so the BASH_SOURCE walk lands on the copy with no neighboring lib/.
# That's why a fallback to $HOME/.serious-sidekick is required for Windows.
_script_path="${BASH_SOURCE[0]}"
while [ -L "$_script_path" ]; do
  _script_dir="$(cd -P "$(dirname "$_script_path")" && pwd)"
  _script_path="$(readlink "$_script_path")"
  [[ $_script_path != /* ]] && _script_path="$_script_dir/$_script_path"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_script_path")" && pwd)"
unset _script_path _script_dir

REPO_ROOT=""
for _candidate in \
  "$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)" \
  "${SERIOUS_SIDEKICK_HOME:-}" \
  "$HOME/.serious-sidekick"
do
  if [ -n "$_candidate" ] && [ -f "$_candidate/lib/serious-common.sh" ]; then
    REPO_ROOT="$_candidate"
    break
  fi
done
unset _candidate

if [ -z "$REPO_ROOT" ]; then
  echo "ERROR: Cannot find lib/serious-common.sh." >&2
  echo "       Looked next to script ($SCRIPT_DIR/..), in \$SERIOUS_SIDEKICK_HOME, and in \$HOME/.serious-sidekick." >&2
  echo "       Reinstall with: curl -fsSL https://raw.githubusercontent.com/AntoineDubuc/serious-sidekick/main/install.sh | bash" >&2
  exit 1
fi
source "$REPO_ROOT/lib/serious-common.sh"

# --- Defaults ---
# Default SIDEKICK_HOME to the BASH_SOURCE-resolved REPO_ROOT (above) so that
# custom-location installs survive past the first invocation without requiring
# the user to re-export SERIOUS_SIDEKICK_HOME on every run (research.md#Finding-3).
# An explicit SERIOUS_SIDEKICK_HOME env var still overrides.
SIDEKICK_HOME="${SERIOUS_SIDEKICK_HOME:-$REPO_ROOT}"
if [ -n "${SERIOUS_TARGET_DIRS:-}" ]; then
  IFS=' ' read -ra TARGET_DIRS <<< "$SERIOUS_TARGET_DIRS"
else
  # Auto-detection (install-ux-detect-dirs Plan 1).
  # When SERIOUS_TARGET_DIRS is unset, validate HOME, then pick only ~/.claude*
  # dirs that already exist. The three candidate dirnames (claude, claude-work,
  # claude-alex) are a fixed allowlist — never derived from runtime input.
  if [ ! -d "${HOME:-}" ]; then
    echo "ERROR: HOME is not set or not a directory; cannot determine default target directories. Set SERIOUS_TARGET_DIRS to bypass." >&2
    exit 1
  fi
  TARGET_DIRS=()
  for _dd_name in claude claude-work claude-alex; do
    _dd_path="$HOME/.$_dd_name"
    # Include real dirs AND dangling symlinks. [ -d ] follows symlinks, so a
    # broken symlink returns false; [ -L ] catches it. Including dangling
    # symlinks lets distribute_to_dir WARN about them (it has the distinct
    # dangling-symlink message) instead of silently skipping at auto-detect.
    if [ -d "$_dd_path" ] || [ -L "$_dd_path" ]; then
      TARGET_DIRS+=("$_dd_path")
    fi
  done
  unset _dd_path
  # Empty-slate fallback: the canonical Claude dir is the single defensible
  # default. The directory will be created lazily at distribute time (after
  # flag parsing) so that read-only flags like --help, --check, --diff
  # don't create directories as a side effect.
  EMPTY_SLATE_FALLBACK=false
  if [ ${#TARGET_DIRS[@]} -eq 0 ]; then
    EMPTY_SLATE_FALLBACK=true
    TARGET_DIRS=("$HOME/.claude")
  fi
  unset _dd_name
fi

# --- Flag parsing ---
CHECK_ONLY=false
DIFF_ONLY=false
ROLLBACK=false
NO_GLOBAL=false
VERIFY_ONLY=false

usage() {
  cat <<'USAGE'
Usage: serious-update [OPTIONS]

Options:
  --check       Check for staleness, write staleness.json, apply no changes
  --diff        Show what would change without applying
  --rollback    Revert to previous_commit from state file
  --verify      Check install integrity against state files and manifest (read-only)
  --no-global   Skip global directory distribution
  --help        Show this help message

Environment variables:
  SERIOUS_SIDEKICK_HOME   Override ~/.serious-sidekick/ (for testing)
  SERIOUS_TARGET_DIRS     Override global dirs, space-separated (for testing)

Exit codes:
  0  Success
  1  Error / Drift detected
  2  Nothing to update / state files missing or unparseable
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)    CHECK_ONLY=true ;;
    --diff)     DIFF_ONLY=true ;;
    --rollback) ROLLBACK=true ;;
    --verify)   VERIFY_ONLY=true ;;
    --no-global) NO_GLOBAL=true ;;
    --help)     usage; exit 0 ;;
    *)
      echo "ERROR: Unknown flag: $1" >&2
      echo "Run 'serious-update --help' for usage." >&2
      exit 1
      ;;
  esac
  shift
done

# --verify and --diff are mutually exclusive — diff is a write-preview, verify
# is read-only integrity check. Combining them invites confusion (research.md
# Finding-5 defensive design).
if [ "$VERIFY_ONLY" = "true" ] && [ "$DIFF_ONLY" = "true" ]; then
  echo "ERROR: --verify and --diff are mutually exclusive" >&2
  exit 1
fi

# --- Validate SIDEKICK_HOME exists ---
if [ ! -d "$SIDEKICK_HOME" ]; then
  echo "ERROR: Serious Sidekick home not found: $SIDEKICK_HOME" >&2
  echo "Run install.sh first, or set SERIOUS_SIDEKICK_HOME." >&2
  exit 1
fi

# --- Banner: which SIDEKICK_HOME this run is operating on (research.md#Finding-7) ---
# Placed AFTER validation + AFTER flag parsing — so --help, which exits inside the
# flag-parsing loop, is naturally exempt. Stderr only.
echo "Using $SIDEKICK_HOME" >&2
if [ "$SIDEKICK_HOME" != "$HOME/.serious-sidekick" ]; then
  echo "NOTE: Running against $SIDEKICK_HOME (canonical install is $HOME/.serious-sidekick)." >&2
fi

# --- Audit log ---
AUDIT_LOG="$SIDEKICK_HOME/update.log"

log_audit() {
  local entry="$1"
  local timestamp
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo "$timestamp $entry" >> "$AUDIT_LOG"
}

# --- Error-surface helpers (Task 1, research.md#Finding-1) -----------
# Captured stderr from git/helper failures is surfaced both to the user
# (multi-line, full text) and to the audit log (single-line, ≤500 chars,
# locale-stable English). Credentials embedded in HTTPS URLs are redacted
# from BOTH sinks before they're written.

# Redact inline HTTPS credentials of the form scheme://user:pass@host.
# Stdin → stdout pass-through. (sed -E for portable extended regex.)
_redact_creds() {
  sed 's#://[^@[:space:]]*@#://REDACTED@#g'
}

# Collapse captured stderr to a bounded, single-line audit payload.
# - tr '\n' '|' : single line for grep-friendly audit log entries.
# - head -c 500 : cap entry length (research.md#Finding-1 head -c 500 cap).
_audit_collapse() {
  _redact_creds | tr '\n' '|' | head -c 500
}

# --- Migration warning (install-ux-detect-dirs Plan 1) ---
# When a previously-distributed-to non-canonical profile dir (.claude-work or
# .claude-alex) no longer exists on disk, emit a one-time NOTE telling the user
# the dir was previously a target. Suppressed by per-dir marker files.
#
# Detection uses an anchored grep against the structured "DISTRIBUTE-DIR dir=..."
# log entries written below — a loose substring match would be a log-poisoning
# surface. Marker filenames come from a fixed allowlist (claude-work, claude-alex)
# — never derived from runtime input.
emit_migration_warnings() {
  # Only run when auto-detecting (env var bypasses)
  [ -n "${SERIOUS_TARGET_DIRS:-}" ] && return 0
  [ ! -d "${HOME:-}" ] && return 0
  [ ! -f "$AUDIT_LOG" ] && return 0

  local _dd_name _dd_target _dd_marker
  for _dd_name in claude-work claude-alex; do
    _dd_target="$HOME/.$_dd_name"
    # If the dir still exists, no migration warning needed.
    [ -d "$_dd_target" ] && continue
    # If marker already written, skip (one-shot semantics).
    _dd_marker="$SIDEKICK_HOME/migration-warned-$_dd_name"
    [ -f "$_dd_marker" ] && continue
    # Anchored grep against structured DISTRIBUTE-DIR entries written below.
    # Pattern matches: "<ISO timestamp> DISTRIBUTE-DIR dir=<HOME>/.<name>$"
    if grep -qE "^[0-9-]+T[0-9:]+Z DISTRIBUTE-DIR dir=$HOME/\\.$_dd_name\$" "$AUDIT_LOG" 2>/dev/null; then
      printf '%s\n' "NOTE: ~/.$_dd_name was previously distributed to but no longer exists. To re-include it, create the directory or set SERIOUS_TARGET_DIRS." >&2
      touch "$_dd_marker" 2>/dev/null || true
    fi
  done
  unset _dd_name _dd_target _dd_marker
}

# --- Git operations ---

# Site #4 (research.md#Finding-1): capture rev-parse stderr and surface
# a specific error ("cannot read HEAD: <real git stderr>") instead of the
# generic "Not a git repository" lie.
#
# IMPORTANT (Task 1 fixup): all callers invoke this via command
# substitution — `old_commit=$(get_current_commit)` — which runs the
# function body inside a subshell. Any variable assignment we make here
# (e.g., a global _GET_HEAD_ERR) is discarded when the subshell exits, so
# the parent would never see the captured stderr. To avoid that trap, we
# print the user-facing error to stderr (fd 2 is inherited across the
# subshell) and write the audit log entry from inside the function. The
# caller's job shrinks to checking `[ -z "$out" ]` and exiting.
#
# Captured stderr is piped through `_redact_creds` before being printed
# or audited so any inline HTTPS credentials in error output don't leak.
get_current_commit() {
  local out err_file err_content
  err_file=$(mktemp)
  if out=$(LC_ALL=C git -C "$SIDEKICK_HOME" rev-parse HEAD 2>"$err_file"); then
    rm -f "$err_file"
    echo "$out"
    return 0
  fi
  err_content=$(cat "$err_file" 2>/dev/null)
  rm -f "$err_file"
  # User-facing stderr: full text, redacted. Subshells inherit fd 2.
  echo "ERROR: cannot read HEAD in $SIDEKICK_HOME: $(printf '%s' "$err_content" | _redact_creds)" >&2
  # Audit log: bounded single line, redacted via _audit_collapse.
  log_audit "ERROR cannot read HEAD: $(printf '%s' "$err_content" | _audit_collapse)"
  echo ""
  return 1
}

do_git_pull() {
  local old_commit
  old_commit=$(get_current_commit)
  if [ -z "$old_commit" ]; then
    # Site #4: get_current_commit already printed the user-facing error
    # to stderr and wrote the audit log entry (it has to — the caller
    # runs the function in a subshell, so any global it set would be lost).
    exit 1
  fi

  # Finding 3 (research.md#Finding-3): detached-HEAD guard. After
  # `serious-update --rollback`, do_rollback does `git checkout <previous>`
  # which leaves $SIDEKICK_HOME on a detached HEAD. The next regular
  # `serious-update` then runs `git pull`, which fails with git's opaque
  # "You are not currently on a branch" message — Task 1's pull-error
  # capture surfaces that text honestly, but the user still doesn't know
  # how to recover. This one-line guard checks for detached HEAD BEFORE
  # the pull, and emits a specific, actionable recovery instruction.
  #
  # Scope: only do_git_pull. do_git_fetch (called by --check) tolerates
  # detached HEAD just fine — `origin/main` and `origin/master` resolve
  # regardless of where HEAD points.
  #
  # Recovery wording: names `git -C $SIDEKICK_HOME checkout main` and ONLY
  # that. The research notes a future `--force` flag (Finding 6) as an
  # alternate recovery path, but Finding 6 is DEFERRED in this plan — the
  # message references only commands that actually ship today.
  if ! git -C "$SIDEKICK_HOME" symbolic-ref -q HEAD >/dev/null 2>&1; then
    echo "ERROR: $SIDEKICK_HOME is on a detached HEAD (after --rollback?). Run 'git -C $SIDEKICK_HOME checkout main' to recover." >&2
    log_audit "ERROR detached HEAD in $SIDEKICK_HOME"
    exit 1
  fi

  # Site #1 (research.md#Finding-1): capture git pull's stderr and surface
  # the real error to the user + audit log (locale-stable English, bounded).
  local pull_err
  if ! pull_err=$(LC_ALL=C git -C "$SIDEKICK_HOME" pull 2>&1 >/dev/null); then
    pull_err=$(printf '%s' "$pull_err" | _redact_creds)
    echo "ERROR: git pull failed in $SIDEKICK_HOME:" >&2
    printf '  %s\n' "$pull_err" >&2
    log_audit "ERROR git pull failed: $(printf '%s' "$pull_err" | _audit_collapse)"
    exit 1
  fi

  local new_commit
  new_commit=$(get_current_commit)

  # Auto-regenerate manifest from the just-pulled sources (research.md#Finding-1
  # part 2 option a). Without this, dev-time edits to source files mismatch the
  # in-tree manifest and silently get skipped at distribution time.
  # Pipeline: regen → JSON-validity check → atomic rename. Site #5: each step
  # is checked separately so the error message names the failed step.
  if [ -x "$SIDEKICK_HOME/bin/generate-manifest.sh" ]; then
    # Step 1: generate-manifest.sh emits to manifest.json.new
    local regen_err
    if ! regen_err=$(MANIFEST_PATH="$SIDEKICK_HOME/manifest.json.new" \
                     LC_ALL=C bash "$SIDEKICK_HOME/bin/generate-manifest.sh" "$SIDEKICK_HOME" 2>&1 >/dev/null); then
      regen_err=$(printf '%s' "$regen_err" | _redact_creds)
      echo "ERROR: generate-manifest.sh failed:" >&2
      printf '  %s\n' "$regen_err" >&2
      echo "ERROR: manifest regeneration failed after git pull" >&2
      log_audit "ERROR generate-manifest.sh failed: $(printf '%s' "$regen_err" | _audit_collapse)"
      rm -f "$SIDEKICK_HOME/manifest.json.new"
      exit 1
    fi

    # Step 2: validate that the regenerated file is valid JSON
    local json_err
    if ! json_err=$(LC_ALL=C $_SERIOUS_JSON_BACKEND -m json.tool "$SIDEKICK_HOME/manifest.json.new" 2>&1 >/dev/null); then
      json_err=$(printf '%s' "$json_err" | _redact_creds)
      echo "ERROR: regenerated manifest.json is not valid JSON:" >&2
      printf '  %s\n' "$json_err" >&2
      echo "ERROR: manifest regeneration failed after git pull" >&2
      log_audit "ERROR regenerated manifest.json invalid: $(printf '%s' "$json_err" | _audit_collapse)"
      rm -f "$SIDEKICK_HOME/manifest.json.new"
      exit 1
    fi

    # Step 2.5 (Task 3 / Finding 4): compare regenerated content against the
    # committed manifest. If they describe the same file set with the same
    # hashes, skip the mv — this breaks the self-defeating loop where every
    # successful pull left manifest.json modified in the working tree (which
    # then made the next git pull refuse on a dirty tree). When they differ,
    # the mv still proceeds (so regenerated truth wins over a stale committed
    # manifest), but we emit a user-visible NOTE on stderr and a
    # MANIFEST-REGEN-OVERRIDE audit line so the override is never silent.
    #
    # Comparison is on a CANONICAL form that strips the non-deterministic
    # `generated_from_commit` field (research.md#Finding-4 "non-deterministic
    # field"): since committing the manifest moves HEAD forward, a committed
    # manifest can never have generated_from_commit == its own commit's SHA,
    # so a strict byte comparison would never match in practice and the loop
    # would never close. Stripping the field lets equality reflect actual
    # source-content equivalence. Short hashes are first 8 chars of SHA-256,
    # matching the existing `verified_hash` convention. We still report the
    # RAW file-content hashes in the NOTE/audit so the user can grep update
    # logs by the same byte-identity they'd see from `shasum manifest.json`.
    local committed_short="" regen_short=""
    local committed_canon="" regen_canon=""
    if [ -f "$SIDEKICK_HOME/manifest.json" ]; then
      committed_short=$(shasum -a 256 "$SIDEKICK_HOME/manifest.json" 2>/dev/null | awk '{print substr($1,1,8)}')
      committed_canon=$(LC_ALL=C $_SERIOUS_JSON_BACKEND -c "
import json, sys, hashlib
with open(sys.argv[1]) as f:
    m = json.load(f)
m.pop('generated_from_commit', None)
out = json.dumps(m, indent=2, sort_keys=True, ensure_ascii=False) + '\n'
print(hashlib.sha256(out.encode('utf-8')).hexdigest())
" "$SIDEKICK_HOME/manifest.json" 2>/dev/null)
    fi
    regen_short=$(shasum -a 256 "$SIDEKICK_HOME/manifest.json.new" 2>/dev/null | awk '{print substr($1,1,8)}')
    regen_canon=$(LC_ALL=C $_SERIOUS_JSON_BACKEND -c "
import json, sys, hashlib
with open(sys.argv[1]) as f:
    m = json.load(f)
m.pop('generated_from_commit', None)
out = json.dumps(m, indent=2, sort_keys=True, ensure_ascii=False) + '\n'
print(hashlib.sha256(out.encode('utf-8')).hexdigest())
" "$SIDEKICK_HOME/manifest.json.new" 2>/dev/null)
    if [ -n "$committed_canon" ] && [ -n "$regen_canon" ] && [ "$committed_canon" = "$regen_canon" ]; then
      # Canonical-equal path: same file set, same hashes — regenerated output
      # would only update the stale `generated_from_commit` metadata. Skip
      # the mv so the working tree stays clean (breaks the loop).
      rm -f "$SIDEKICK_HOME/manifest.json.new"
    else
      # Diverge path (or fresh install where committed manifest didn't
      # exist): proceed with mv, but warn loudly if we overwrote a real
      # committed manifest. Skip the NOTE when committed_short is empty
      # (genuinely first-time generation, nothing to override).
      local mv_err
      if ! mv_err=$(LC_ALL=C mv "$SIDEKICK_HOME/manifest.json.new" "$SIDEKICK_HOME/manifest.json" 2>&1 >/dev/null); then
        mv_err=$(printf '%s' "$mv_err" | _redact_creds)
        echo "ERROR: mv manifest.json.new -> manifest.json failed:" >&2
        printf '  %s\n' "$mv_err" >&2
        echo "ERROR: manifest regeneration failed after git pull" >&2
        log_audit "ERROR mv manifest.json.new failed: $(printf '%s' "$mv_err" | _audit_collapse)"
        rm -f "$SIDEKICK_HOME/manifest.json.new"
        exit 1
      fi
      if [ -n "$committed_short" ]; then
        echo "NOTE: committed manifest.json was overwritten by regenerated output (commit hash $committed_short, regen hash $regen_short); commit the regen output to your fork to silence this NOTE" >&2
        log_audit "MANIFEST-REGEN-OVERRIDE committed=$committed_short regen=$regen_short"
      fi
    fi
  fi

  echo "$old_commit"
  echo "$new_commit"
}

do_git_fetch() {
  local local_commit
  local_commit=$(get_current_commit)
  if [ -z "$local_commit" ]; then
    # Site #4: get_current_commit already printed + audited; just exit.
    exit 1
  fi

  # Site #2 (sync-pair with Site #1): identical error-handling block.
  local fetch_err
  if ! fetch_err=$(LC_ALL=C git -C "$SIDEKICK_HOME" fetch origin 2>&1 >/dev/null); then
    fetch_err=$(printf '%s' "$fetch_err" | _redact_creds)
    echo "ERROR: git fetch failed in $SIDEKICK_HOME:" >&2
    printf '  %s\n' "$fetch_err" >&2
    log_audit "ERROR git fetch failed: $(printf '%s' "$fetch_err" | _audit_collapse)"
    exit 1
  fi

  # Site #3 (research.md#Finding-1): when neither origin/main nor
  # origin/master resolves, exit 1 with an explicit error instead of
  # returning an empty remote_commit string (which downstream lies as
  # "Update available: local=<sha> remote=").
  # NOTE: --verify is required. Plain `git rev-parse origin/main` on a
  # missing ref echoes the ref name back on stdout AND exits non-zero —
  # which would leak the literal string "origin/main" into remote_commit
  # via command substitution. --verify gives empty stdout on failure.
  local remote_commit
  remote_commit=$(LC_ALL=C git -C "$SIDEKICK_HOME" rev-parse --verify origin/main 2>/dev/null || \
                  LC_ALL=C git -C "$SIDEKICK_HOME" rev-parse --verify origin/master 2>/dev/null || echo "")
  if [ -z "$remote_commit" ]; then
    echo "ERROR: no origin/main or origin/master in $SIDEKICK_HOME" >&2
    log_audit "ERROR no origin/main or origin/master"
    exit 1
  fi

  echo "$local_commit"
  echo "$remote_commit"
}

# --- Manifest reading ---

do_read_manifest() {
  local manifest_path="$SIDEKICK_HOME/manifest.json"
  if [ ! -f "$manifest_path" ]; then
    echo "ERROR: manifest.json not found at $manifest_path" >&2
    exit 1
  fi

  local parsed
  parsed=$(parse_manifest "$manifest_path" 2>&1)
  local exit_code=$?
  if [ $exit_code -ne 0 ]; then
    # Site #8 (research.md#Finding-1): forensic-blind exit gets an audit
    # entry with the captured parse_manifest stderr — redacted via
    # _audit_collapse. Per plan AC line 487, the user-stderr message is
    # also redacted before being printed. parse_manifest stderr doesn't
    # normally carry HTTPS URLs, but the filter is wired in for literal
    # plan-AC compliance.
    parsed=$(printf '%s' "$parsed" | _redact_creds)
    echo "ERROR: Failed to parse manifest.json" >&2
    echo "$parsed" >&2
    log_audit "ERROR parse_manifest failed: $(printf '%s' "$parsed" | _audit_collapse)"
    exit 1
  fi
  echo "$parsed"
}

# --- File distribution engine ---

# distribute_to_dir <target_dir> <manifest_entries> <dry_run>
# Returns: "updated=N new=N current=N skipped=N errors=N hash_mismatches=N"
distribute_to_dir() {
  local target_dir="$1"
  local manifest_entries="$2"
  local dry_run="${3:-false}"
  local current_commit="$4"
  local previous_commit="$5"

  local updated=0
  local new_count=0
  local current=0
  local skipped=0
  local errors=0
  local hash_mismatches=0
  local file_hashes="{}"

  # Skip-with-warning instead of silent mkdir -p (install-ux-detect-dirs Plan 1).
  # Dangling-symlink check first (distinct from missing-dir) for diagnostic clarity.
  if [ -L "$target_dir" ] && [ ! -e "$target_dir" ]; then
    local _link_target
    _link_target=$(readlink "$target_dir" 2>/dev/null | LC_ALL=C tr -d '\000-\037\177')
    printf '%s\n' "WARNING: target directory is a dangling symlink, skipping: $target_dir (broken link to: '$_link_target')" >&2
    echo "updated=0 new=0 current=0 skipped=0 errors=0 hash_mismatches=0"
    return 0
  fi
  if [ ! -d "$target_dir" ]; then
    printf '%s\n' "WARNING: target directory does not exist, skipping: $target_dir" >&2
    echo "updated=0 new=0 current=0 skipped=0 errors=0 hash_mismatches=0"
    return 0
  fi

  while IFS=$'\t' read -r src ownership dest sha256 merge_key; do
    [ -z "$src" ] && continue

    local source_path="$SIDEKICK_HOME/$src"
    local dest_path="$target_dir/$dest"

    # Handle relative paths that go up (e.g., ../_implementation_plan_template_v6.md)
    # dest is relative to target_dir

    case "$ownership" in
      template)
        if [ ! -f "$source_path" ]; then
          if [ "$dry_run" = "true" ]; then
            echo "  MISSING  $dest (source not found: $src)"
          fi
          errors=$((errors + 1))
          continue
        fi

        if [ "$dry_run" = "true" ]; then
          # Run the same SHA-256 self-consistency check the real run runs, so
          # --diff doesn't lie about what would land. Mismatch → SKIP preview.
          if [ -n "$sha256" ]; then
            local dryrun_actual_hash
            dryrun_actual_hash=$(hash_file "$source_path" 2>/dev/null || echo "")
            if [ -n "$dryrun_actual_hash" ] && [ "$dryrun_actual_hash" != "$sha256" ]; then
              echo "  SKIP  $dest (hash mismatch — would be skipped at real-run time)"
              hash_mismatches=$((hash_mismatches + 1))
              continue
            fi
          fi
          if [ -f "$dest_path" ]; then
            local current_hash
            current_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
            local new_hash
            new_hash=$(hash_file "$source_path" 2>/dev/null || echo "")
            if [ "$current_hash" = "$new_hash" ]; then
              echo "  CURRENT  $dest"
              current=$((current + 1))
            else
              echo "  OVERWRITE  $dest"
              updated=$((updated + 1))
            fi
          else
            echo "  NEW  $dest"
            new_count=$((new_count + 1))
          fi
          continue
        fi

        # Create destination directory if needed
        local dest_dir
        dest_dir=$(dirname "$dest_path")
        mkdir -p "$dest_dir" 2>/dev/null || {
          echo "  ERROR: Cannot create directory for $dest" >&2
          errors=$((errors + 1))
          continue
        }

        # SHA-256 self-consistency check (sources must match the in-tree manifest — does NOT defend against upstream tamper, see research.md#Finding-9)
        if [ -n "$sha256" ]; then
          local actual_hash
          actual_hash=$(hash_file "$source_path" 2>/dev/null || echo "")
          if [ -n "$actual_hash" ] && [ "$actual_hash" != "$sha256" ]; then
            echo "  HASH MISMATCH: $dest (expected: ${sha256:0:16}…, got: ${actual_hash:0:16}…)" >&2
            hash_mismatches=$((hash_mismatches + 1))
            continue
          fi
        fi

        # Check if file already current
        if [ -f "$dest_path" ]; then
          local current_hash new_hash
          current_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
          new_hash=$(hash_file "$source_path" 2>/dev/null || echo "")
          if [ "$current_hash" = "$new_hash" ]; then
            current=$((current + 1))
            # Still record the hash
            file_hashes=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
h = json.loads(sys.argv[1])
h[sys.argv[2]] = sys.argv[3]
print(json.dumps(h))
" "$file_hashes" "$dest" "$current_hash")
            continue
          fi
        fi

        if cp "$source_path" "$dest_path" 2>/dev/null; then
          local new_hash
          new_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
          file_hashes=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
h = json.loads(sys.argv[1])
h[sys.argv[2]] = sys.argv[3]
print(json.dumps(h))
" "$file_hashes" "$dest" "$new_hash")
          if [ -f "$dest_path" ]; then
            # Was it there before? (we already know hashes differ if we got here)
            updated=$((updated + 1))
          else
            new_count=$((new_count + 1))
          fi
        else
          # Site #7 (research.md#Finding-1): forensic-blind gap close.
          # Audit log records the cp failure; user-facing message is
          # intentionally left unchanged (already specific).
          log_audit "ERROR cp $src -> $dest failed in $target_dir"
          echo "  ERROR: Failed to copy $src -> $dest" >&2
          errors=$((errors + 1))
        fi
        ;;

      merge)
        # Skip merge-tier files (settings.json hooks) for global dirs.
        # Hooks use $CLAUDE_PROJECT_DIR paths that only work in projects
        # where /serious-init has been run. Merging them into global
        # settings breaks every project that hasn't run /serious-init.
        # Settings.json hooks are installed per-project by /serious-init.
        echo "  SKIP  $dest (merge-tier — hooks are project-level, use /serious-init)"
        skipped=$((skipped + 1))
        ;;

      user-init)
        if [ "$dry_run" = "true" ]; then
          if [ -f "$dest_path" ]; then
            echo "  SKIP  $dest (user-init, already exists)"
            skipped=$((skipped + 1))
          else
            echo "  NEW  $dest (user-init, first install)"
            new_count=$((new_count + 1))
          fi
          continue
        fi

        if [ -f "$dest_path" ]; then
          # Already exists: skip
          skipped=$((skipped + 1))
          # Record existing hash for state tracking
          local existing_hash
          existing_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
          file_hashes=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
h = json.loads(sys.argv[1])
h[sys.argv[2]] = sys.argv[3]
print(json.dumps(h))
" "$file_hashes" "$dest" "$existing_hash")
        else
          # First install: copy
          if [ ! -f "$source_path" ]; then
            errors=$((errors + 1))
            continue
          fi
          local dest_dir
          dest_dir=$(dirname "$dest_path")
          mkdir -p "$dest_dir" 2>/dev/null || {
            errors=$((errors + 1))
            continue
          }
          if cp "$source_path" "$dest_path" 2>/dev/null; then
            local new_hash
            new_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
            file_hashes=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
h = json.loads(sys.argv[1])
h[sys.argv[2]] = sys.argv[3]
print(json.dumps(h))
" "$file_hashes" "$dest" "$new_hash")
            new_count=$((new_count + 1))
          else
            errors=$((errors + 1))
          fi
        fi
        ;;
    esac
  done <<< "$manifest_entries"

  # Write state file LAST — only if not dry run and no critical errors.
  # Site #6 (research.md#Finding-1): capture update_state's stderr so the
  # operator sees the actual failure reason indented under the existing
  # user-facing line. errors=$((errors+1)) still increments.
  #
  # The captured stderr is piped through _redact_creds before BOTH the
  # user-stderr write and the audit-log write (plan AC line 487:
  # "The user-stderr message is also redacted before being printed.").
  # update_state stderr doesn't normally carry HTTPS URLs, but the
  # filter is wired in for literal plan-AC compliance.
  if [ "$dry_run" = "false" ] && [ "$errors" -eq 0 ]; then
    local upd_err
    if ! upd_err=$(update_state "$target_dir" "$current_commit" "$previous_commit" "$file_hashes" 2>&1 >/dev/null); then
      upd_err=$(printf '%s' "$upd_err" | _redact_creds)
      echo "  ERROR: Failed to write state file for $target_dir:" >&2
      printf '    %s\n' "$upd_err" >&2
      log_audit "ERROR update_state failed for $target_dir: $(printf '%s' "$upd_err" | _audit_collapse)"
      errors=$((errors + 1))
    else
      # Task 7 / Finding 10: clear the corruption sentinel after a successful
      # update_state. If the sentinel was present (post-corruption recovery
      # path), this completes the recovery cycle. -f makes the call a no-op
      # when no sentinel exists — the common case.
      rm -f "$target_dir/.serious-sidekick-state.corrupt"
    fi
  fi

  echo "updated=$updated new=$new_count current=$current skipped=$skipped errors=$errors hash_mismatches=$hash_mismatches"
}

# --- --check implementation ---

do_check() {
  local commits
  commits=$(do_git_fetch)
  local local_commit remote_commit
  local_commit=$(echo "$commits" | head -1)
  remote_commit=$(echo "$commits" | tail -1)

  # Count stale files by comparing manifest hashes against installed
  local stale_count=0
  local summary="up to date"

  if [ "$local_commit" != "$remote_commit" ]; then
    # Try to count how many files would change
    # For a simple implementation, just report the commits differ
    stale_count=1
    summary="Update available: local=$local_commit remote=$remote_commit"
  fi

  # Write staleness.json
  $_SERIOUS_JSON_BACKEND -c "
import json, sys
from datetime import datetime, timezone

data = {
    'checked_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'local_commit': sys.argv[1],
    'remote_commit': sys.argv[2],
    'stale_count': int(sys.argv[3]),
    'summary': sys.argv[4]
}

with open(sys.argv[5], 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
" "$local_commit" "$remote_commit" "$stale_count" "$summary" "$SIDEKICK_HOME/staleness.json"

  # Write CHECK audit log entry
  log_audit "CHECK  $local_commit remote=$remote_commit stale=$stale_count"

  echo "Staleness check complete."
  echo "  Local:  $local_commit"
  echo "  Remote: $remote_commit"
  if [ "$stale_count" -gt 0 ]; then
    echo "  Status: Update available"
  else
    echo "  Status: Up to date"
  fi
  echo "  Written: $SIDEKICK_HOME/staleness.json"

  exit 0
}

# --- --verify implementation (research.md#Finding-5) ---
#
# Read-only drift detection. For each target dir:
#   (a) compare state file's installed_from_commit vs. current HEAD
#   (b) compare on-disk file hashes vs state file's recorded hashes
#   (c) compare manifest source hashes vs actual source-file hashes in $SIDEKICK_HOME
#
# Exit codes:
#   0  all dirs in sync (commit + both hash axes)
#   1  drift on any axis in any dir
#   2  state file missing/unparseable in any dir, OR no target dirs configured
#
# Does NOT call git fetch / git pull — that's --check's job. Does NOT modify
# any file (only update.log gets one VERIFY audit line per invocation).
do_verify() {
  # NT3: empty target-dir list → indeterminate state, exit 2.
  if [ ${#TARGET_DIRS[@]} -eq 0 ]; then
    echo "No target directories configured" >&2
    log_audit "VERIFY - dirs=0/0 drift=0"
    exit 2
  fi

  # Get current HEAD (does NOT fetch — read-only).
  local local_commit
  local_commit=$(get_current_commit)
  if [ -z "$local_commit" ]; then
    # get_current_commit already printed + audited.
    exit 1
  fi

  # Read manifest entries up front (parsed source paths + recorded sha256s).
  local manifest_entries
  manifest_entries=$(do_read_manifest) || exit 1

  # Dirty-manifest warning (stderr, BEFORE per-dir output). The warning alone
  # does NOT drive exit code — only actual hash mismatches do.
  if ! git -C "$SIDEKICK_HOME" diff --quiet manifest.json 2>/dev/null; then
    echo "WARNING: $SIDEKICK_HOME/manifest.json is dirty — verification reflects current source-tree state, not committed manifest" >&2
  fi

  local dirs_total=${#TARGET_DIRS[@]}
  local dirs_ok=0
  local total_drift=0
  local exit_code=0
  local saw_missing_or_unparseable=false

  # Per-dir verification loop.
  local dir
  for dir in "${TARGET_DIRS[@]}"; do
    local state_file="$dir/.serious-sidekick-state.json"

    # Missing state file → exit 2 (don't bail mid-loop; keep reporting all dirs).
    if [ ! -f "$state_file" ]; then
      echo "WARNING: $dir missing state file (first run never completed?)" >&2
      saw_missing_or_unparseable=true
      continue
    fi

    # Unparseable state file → exit 2.
    if ! validate_json "$state_file" 2>/dev/null; then
      local sf_err
      sf_err=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
try:
    json.load(open(sys.argv[1]))
except Exception as e:
    print(str(e))
" "$state_file" 2>&1 | head -1)
      echo "ERROR: $dir state file unparseable: $sf_err" >&2
      saw_missing_or_unparseable=true
      continue
    fi

    # Read installed_from_commit + file_hashes from state file.
    local installed_from_commit
    installed_from_commit=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
data = json.load(open(sys.argv[1]))
print(data.get('installed_from_commit', ''))
" "$state_file" 2>/dev/null)

    # Compute drift_vs_state: on-disk hash vs recorded hash for each manifest entry.
    # Compute drift_vs_manifest: source-file hash in SIDEKICK_HOME vs manifest's sha256.
    # state_hashes is the file_hashes object from the state file (dest -> sha256).
    local drift_vs_state=0
    local drift_vs_manifest=0

    while IFS=$'\t' read -r src ownership dest sha256 merge_key; do
      [ -z "$src" ] && continue
      # Only check template-tier entries — merge-tier (settings.json) is
      # skipped at distribution, and user-init files diverge by design.
      [ "$ownership" != "template" ] && continue

      local source_path="$SIDEKICK_HOME/$src"
      local dest_path="$dir/$dest"

      # (b) drift_vs_state — recorded hash for "$dest" vs current on-disk hash.
      if [ -f "$dest_path" ]; then
        local actual_dest_hash recorded_dest_hash
        actual_dest_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
        recorded_dest_hash=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
data = json.load(open(sys.argv[1]))
print(data.get('file_hashes', {}).get(sys.argv[2], ''))
" "$state_file" "$dest" 2>/dev/null)
        if [ -n "$recorded_dest_hash" ] && [ -n "$actual_dest_hash" ] \
           && [ "$actual_dest_hash" != "$recorded_dest_hash" ]; then
          drift_vs_state=$((drift_vs_state + 1))
        fi
      fi

      # (c) drift_vs_manifest — manifest's sha256 for source file vs current
      # source-file hash. (Defends against Finding-4 regen-mismatch.)
      if [ -n "$sha256" ] && [ -f "$source_path" ]; then
        local actual_src_hash
        actual_src_hash=$(hash_file "$source_path" 2>/dev/null || echo "")
        if [ -n "$actual_src_hash" ] && [ "$actual_src_hash" != "$sha256" ]; then
          drift_vs_manifest=$((drift_vs_manifest + 1))
        fi
      fi
    done <<< "$manifest_entries"

    # Per-dir summary block (stdout — verify is informational, not an error).
    echo "dir: $dir"
    echo "  installed_from_commit: ${installed_from_commit:-missing}"
    echo "  head: $local_commit"
    echo "  drift_vs_state: $drift_vs_state files"
    echo "  drift_vs_manifest: $drift_vs_manifest files"

    # Track aggregate counts + this dir's verdict.
    local dir_clean=true
    if [ "$installed_from_commit" != "$local_commit" ]; then
      dir_clean=false
    fi
    if [ "$drift_vs_state" -gt 0 ] || [ "$drift_vs_manifest" -gt 0 ]; then
      dir_clean=false
    fi
    if [ "$dir_clean" = "true" ]; then
      dirs_ok=$((dirs_ok + 1))
    fi
    total_drift=$((total_drift + drift_vs_state + drift_vs_manifest))
  done

  # Exit-code resolution:
  #   2  any missing/unparseable state file
  #   1  any commit-mismatch OR any drift
  #   0  all clean
  if [ "$saw_missing_or_unparseable" = "true" ]; then
    exit_code=2
  elif [ "$dirs_ok" -lt "$dirs_total" ] || [ "$total_drift" -gt 0 ]; then
    exit_code=1
  else
    exit_code=0
  fi

  log_audit "VERIFY $local_commit dirs=$dirs_ok/$dirs_total drift=$total_drift"
  exit "$exit_code"
}

# --- --rollback implementation ---

do_rollback() {
  # Find the first target dir that has a state file
  local state_file=""
  local current_installed=""
  local previous=""

  for dir in "${TARGET_DIRS[@]}"; do
    if [ -f "$dir/.serious-sidekick-state.json" ]; then
      state_file="$dir/.serious-sidekick-state.json"
      break
    fi
  done

  if [ -z "$state_file" ]; then
    echo "ERROR: No state file found. Nothing to rollback." >&2
    exit 1
  fi

  current_installed=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
data = json.load(open(sys.argv[1]))
print(data.get('installed_from_commit', ''))
" "$state_file")

  previous=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
data = json.load(open(sys.argv[1]))
print(data.get('previous_commit', ''))
" "$state_file")

  if [ -z "$previous" ]; then
    echo "ERROR: No previous_commit in state file. Nothing to rollback." >&2
    exit 1
  fi

  echo "Rolling back from $current_installed to $previous..."

  # Checkout previous commit in the local clone
  if ! git -C "$SIDEKICK_HOME" checkout "$previous" 2>/dev/null; then
    echo "ERROR: git checkout $previous failed" >&2
    exit 1
  fi

  # Read manifest at the previous commit
  local manifest_entries
  manifest_entries=$(do_read_manifest) || exit 1

  # Re-distribute to all target dirs
  local dirs_ok=0
  local dirs_total=${#TARGET_DIRS[@]}

  if [ "$NO_GLOBAL" = "true" ]; then
    dirs_total=0
    dirs_ok=0
  else
    for dir in "${TARGET_DIRS[@]}"; do
      echo "Distributing to $dir..."
      local result
      result=$(distribute_to_dir "$dir" "$manifest_entries" "false" "$previous" "$current_installed")
      local last_line
      last_line=$(echo "$result" | tail -1)
      local err_count
      err_count=$(echo "$last_line" | sed -n 's/.*errors=\([0-9]*\).*/\1/p')
      if [ "${err_count:-0}" -eq 0 ]; then
        dirs_ok=$((dirs_ok + 1))
      fi
    done
  fi

  # Audit log
  log_audit "ROLLBACK home=$SIDEKICK_HOME $current_installed->$previous dirs=$dirs_ok/$dirs_total OK"

  echo ""
  echo "Rollback complete."
  echo "  Reverted: $current_installed -> $previous"
  echo "  Dirs: $dirs_ok/$dirs_total OK"
  echo "  Audit log: $AUDIT_LOG"

  exit 0
}

# --- Migration: first-run state file creation ---

# do_migrate <target_dir> <manifest_entries> <current_commit>
# When no state file exists, hashes all existing installed files that match
# manifest entries and builds an initial state file. Returns the count of
# files found and hashed.
do_migrate() {
  local target_dir="$1"
  local manifest_entries="$2"
  local current_commit="$3"

  local state_file="$target_dir/.serious-sidekick-state.json"
  local sentinel_file="$target_dir/.serious-sidekick-state.corrupt"

  # Skip if state file already exists
  if [ -f "$state_file" ]; then
    return 0
  fi

  # Skip if target dir doesn't exist (nothing to migrate)
  if [ ! -d "$target_dir" ]; then
    return 0
  fi

  # Task 7 / Finding 10: sentinel-aware path. If the corruption sentinel is
  # present (left by a prior update_state post-write validation failure), the
  # on-disk files cannot be trusted as "installed from the current commit" —
  # a previous write crashed mid-flight. Write a state file with
  # installed_from_commit="" so Task 4's NEEDS_REDISTRIBUTE check fires and
  # forces a clean redistribute. Preserve the sentinel — distribute_to_dir
  # clears it after a successful update_state. Do NOT scan on-disk hashes
  # here; they're not authoritative.
  if [ -f "$sentinel_file" ]; then
    # Write state with installed_from_commit="" and empty file_hashes.
    update_state "$target_dir" "" "" "{}" 2>/dev/null || {
      # update_state rejects empty commit_sha by design; we need to write the
      # state file directly to bypass that validation while still preserving
      # the schema. (The empty installed_from_commit is the whole point —
      # it signals "do not trust on-disk hashes" to the freshness gate.)
      local migration_ts
      migration_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      $_SERIOUS_JSON_BACKEND -c "
import json, sys
state = {
    'installed_from_commit': '',
    'previous_commit': '',
    'installed_at': sys.argv[1],
    'file_hashes': {},
}
with open(sys.argv[2], 'w') as f:
    json.dump(state, f, indent=2, sort_keys=True, ensure_ascii=False)
    f.write('\n')
" "$migration_ts" "$state_file" 2>/dev/null || {
        echo "  WARNING: Failed to write sentinel-recovery state for $target_dir" >&2
        return 1
      }
    }
    # Echo 0 so the caller's numeric check still works.
    echo "0"
    return 0
  fi

  local file_count=0
  local file_hashes="{}"

  while IFS=$'\t' read -r src ownership dest sha256 merge_key; do
    [ -z "$src" ] && continue

    local dest_path="$target_dir/$dest"

    if [ -f "$dest_path" ]; then
      local existing_hash
      existing_hash=$(hash_file "$dest_path" 2>/dev/null || echo "")
      if [ -n "$existing_hash" ]; then
        file_hashes=$($_SERIOUS_JSON_BACKEND -c "
import json, sys
h = json.loads(sys.argv[1])
h[sys.argv[2]] = sys.argv[3]
print(json.dumps(h))
" "$file_hashes" "$dest" "$existing_hash")
        file_count=$((file_count + 1))
      fi
    fi
  done <<< "$manifest_entries"

  # Write initial state file
  if [ "$file_count" -gt 0 ]; then
    update_state "$target_dir" "$current_commit" "" "$file_hashes" 2>/dev/null || {
      echo "  WARNING: Failed to write migration state for $target_dir" >&2
      return 1
    }
  else
    # Even with 0 files, create the state file so subsequent runs don't re-migrate
    update_state "$target_dir" "$current_commit" "" "{}" 2>/dev/null || {
      echo "  WARNING: Failed to write migration state for $target_dir" >&2
      return 1
    }
  fi

  echo "$file_count"
}

# --- Main flow ---

# Handle --check
if [ "$CHECK_ONLY" = "true" ]; then
  do_check
fi

# Handle --rollback
if [ "$ROLLBACK" = "true" ]; then
  do_rollback
fi

# Handle --verify (read-only — DOES NOT call git fetch/pull).
# Must come before do_git_pull below so a broken remote doesn't break
# --verify's offline-safe contract (research.md#Finding-5).
if [ "$VERIFY_ONLY" = "true" ]; then
  do_verify
fi

# Regular update (or --diff)

# Migration warnings (install-ux-detect-dirs Plan 1) — emit one-time NOTEs for
# previously-distributed dirs that no longer exist. Runs only in the auto-detect
# branch and only when an audit log exists.
emit_migration_warnings

# Step 1: Git pull
pull_output=$(do_git_pull)
OLD_COMMIT=$(echo "$pull_output" | head -1)
NEW_COMMIT=$(echo "$pull_output" | tail -1)

# Step 2: Check if anything changed — but always proceed if any target dir lacks a state file (first run)
NEEDS_FIRST_RUN=false
if [ "$NO_GLOBAL" != "true" ]; then
  for dir in "${TARGET_DIRS[@]}"; do
    if [ -d "$dir" ] && [ ! -f "$dir/.serious-sidekick-state.json" ]; then
      NEEDS_FIRST_RUN=true
      break
    fi
  done
fi

# Step 2.5: State-aware freshness check (research.md#Finding-2, Task 4).
# Complement of NEEDS_FIRST_RUN: catches "state file exists but at wrong commit"
# (interrupted prior run, hand-edited state file, etc.). Without this, the gate
# below would silently bail (exit 2) on stale targets when OLD==NEW.
#
# Implementation: per-dir parallel array PRIOR_INSTALLED indexed by the SAME
# index as TARGET_DIRS, so the redistribute path downstream can thread the
# correct per-dir previous_commit value into distribute_to_dir.
# (bash 3.2 has no associative arrays; do NOT use `declare -A`.)
#
# Security hardening:
#   S1: isinstance(v,str) check in the python3 read coerces non-string types
#       (list/dict/number/null) to empty string, preventing them from flowing
#       into the audit log or distribute_to_dir args.
#   S3: SHA-shape regex ^[0-9a-f]{7,40}$ validates the value before threading
#       it as previous_commit. Non-SHA values are treated as empty + WARNING.
NEEDS_REDISTRIBUTE=false
# Parallel arrays indexed by TARGET_DIRS index.
#   PRIOR_INSTALLED[$i]      — validated prior installed_from_commit (or '')
#   PRIOR_STATE_PRESENT[$i]  — "true" if the state file existed at scan time
# The "present" flag disambiguates "state file missing (first run)" from
# "state file present but value rejected (S1 non-string / S3 non-SHA)" so the
# distribute path can thread previous_commit='' for the latter while keeping
# the legacy OLD_COMMIT fallback for the former.
PRIOR_INSTALLED=()
PRIOR_STATE_PRESENT=()
if [ "$NO_GLOBAL" != "true" ]; then
  for i in "${!TARGET_DIRS[@]}"; do
    _state_dir="${TARGET_DIRS[$i]}"
    _state_file="$_state_dir/.serious-sidekick-state.json"
    PRIOR_INSTALLED[$i]=""
    PRIOR_STATE_PRESENT[$i]="false"
    if [ -f "$_state_file" ]; then
      PRIOR_STATE_PRESENT[$i]="true"
      # S1: isinstance(v,str) wrapper — non-string types coerce to ''.
      installed=$($_SERIOUS_JSON_BACKEND -c "import json,sys; v=json.load(open(sys.argv[1])).get('installed_from_commit',''); print(v if isinstance(v,str) else '')" "$_state_file" 2>/dev/null)
      # S3: SHA-shape regex — reject anything that isn't a git short/full SHA.
      if [ -n "$installed" ] && ! [[ "$installed" =~ ^[0-9a-f]{7,40}$ ]]; then
        echo "WARNING: $_state_dir state file has non-SHA installed_from_commit value (corrupt or hand-edited); treating as redistribute" >&2
        installed=""
      fi
      PRIOR_INSTALLED[$i]="$installed"
      if [ "$installed" != "$NEW_COMMIT" ]; then
        NEEDS_REDISTRIBUTE=true
      fi
    fi
  done
  unset _state_dir _state_file
fi

if [ "$OLD_COMMIT" = "$NEW_COMMIT" ] \
   && [ "$NEEDS_FIRST_RUN" = "false" ] \
   && [ "$NEEDS_REDISTRIBUTE" = "false" ] \
   && [ "$DIFF_ONLY" = "false" ]; then
  log_audit "UPDATE home=$SIDEKICK_HOME $OLD_COMMIT->$NEW_COMMIT files=0 new=0 dirs=0/0 OK (nothing to update)"
  echo "Already up to date at $NEW_COMMIT"
  exit 2
fi

# Step 3: Read manifest
MANIFEST_ENTRIES=$(do_read_manifest) || exit 1

# Step 3.5: Migration — auto-detect first run for each target dir
# Skip during --diff (dry run must not write anything)
if [ "$NO_GLOBAL" != "true" ] && [ "$DIFF_ONLY" != "true" ]; then
  for dir in "${TARGET_DIRS[@]}"; do
    if [ -d "$dir" ] && [ ! -f "$dir/.serious-sidekick-state.json" ]; then
      migrated_count=$(do_migrate "$dir" "$MANIFEST_ENTRIES" "$NEW_COMMIT" 2>&1)
      # Only print if migrated_count is a number (not an error message)
      if [[ "$migrated_count" =~ ^[0-9]+$ ]]; then
        echo "First run for $dir: scanned $migrated_count existing manifest-matched file(s) (preserved). Proceeding with install."
      fi
    fi
  done
fi

# Step 4: Distribute to target dirs
# Lazy empty-slate mkdir (install-ux-detect-dirs Plan 1): only create the
# canonical ~/.claude/ if we're actually about to distribute (skip on --diff
# preview to keep it read-only).
if [ "${EMPTY_SLATE_FALLBACK:-false}" = "true" ] && [ "$DIFF_ONLY" != "true" ] && [ "$NO_GLOBAL" != "true" ]; then
  mkdir -p "$HOME/.claude" 2>/dev/null || {
    echo "ERROR: Cannot create canonical default ~/.claude directory" >&2
    exit 1
  }
fi

if [ "$NO_GLOBAL" = "true" ]; then
  echo "Skipping global directories (--no-global)."
  TOTAL_DIRS=0
  DIRS_OK=0
  TOTAL_UPDATED=0
  TOTAL_NEW=0
  TOTAL_CURRENT=0
else
  TOTAL_DIRS=${#TARGET_DIRS[@]}
  DIRS_OK=0
  TOTAL_UPDATED=0
  TOTAL_NEW=0
  TOTAL_CURRENT=0
  DIR_REPORTS=()

  for i in "${!TARGET_DIRS[@]}"; do
    dir="${TARGET_DIRS[$i]}"
    if [ "$DIFF_ONLY" = "true" ]; then
      echo ""
      echo "=== $dir ==="
    fi

    # Thread the per-dir prior installed_from_commit as previous_commit so
    # the redistribute-for-staleness path (Task 4) records the correct prior
    # SHA in state. Three cases:
    #   1. State file present + value validated (incl. empty after S1/S3 reject):
    #      thread that exact value (may be '').
    #   2. State file present but PRIOR_INSTALLED is empty due to S1/S3 reject:
    #      thread '' (Task 4 Security ACs require no leak of corrupt value).
    #   3. State file ABSENT (NEEDS_FIRST_RUN path or NO_GLOBAL-skipped scan):
    #      fall back to $OLD_COMMIT (legacy behavior, Scenarios C and D).
    _prev_for_dir=""
    if [ "${PRIOR_STATE_PRESENT[$i]:-false}" = "true" ]; then
      _prev_for_dir="${PRIOR_INSTALLED[$i]:-}"
    else
      _prev_for_dir="$OLD_COMMIT"
    fi

    # Capture stdout only — let stderr flow through so HASH MISMATCH lines
    # remain visible to the user (per research.md#Finding-1; previously the
    # `2>&1` here swallowed them, hiding the silent-drop bug).
    result=$(distribute_to_dir "$dir" "$MANIFEST_ENTRIES" "$DIFF_ONLY" "$NEW_COMMIT" "$_prev_for_dir")

    # Parse the last line for counts
    last_line=$(echo "$result" | tail -1)

    # Show all output for --diff mode (non-summary lines)
    if [ "$DIFF_ONLY" = "true" ]; then
      total_lines=$(echo "$result" | wc -l | tr -d ' ')
      if [ "$total_lines" -gt 1 ]; then
        echo "$result" | sed '$d'
      fi
    fi

    dir_updated=$(echo "$last_line" | sed -n 's/.*updated=\([0-9]*\).*/\1/p')
    dir_new=$(echo "$last_line" | sed -n 's/.*new=\([0-9]*\).*/\1/p')
    dir_current=$(echo "$last_line" | sed -n 's/.*current=\([0-9]*\).*/\1/p')
    dir_errors=$(echo "$last_line" | sed -n 's/.*errors=\([0-9]*\).*/\1/p')
    dir_hash_mismatches=$(echo "$last_line" | sed -n 's/.*hash_mismatches=\([0-9]*\).*/\1/p')

    dir_updated=${dir_updated:-0}
    dir_new=${dir_new:-0}
    dir_current=${dir_current:-0}
    dir_errors=${dir_errors:-0}
    dir_hash_mismatches=${dir_hash_mismatches:-0}

    TOTAL_UPDATED=$((TOTAL_UPDATED + dir_updated))
    TOTAL_NEW=$((TOTAL_NEW + dir_new))
    TOTAL_CURRENT=$((TOTAL_CURRENT + dir_current))

    if [ "$dir_errors" -eq 0 ]; then
      DIRS_OK=$((DIRS_OK + 1))
    fi

    if [ "$dir_hash_mismatches" -gt 0 ]; then
      DIR_REPORTS+=("$dir  $dir_updated updated, $dir_new new, $dir_current current, $dir_hash_mismatches SKIPPED (hash mismatch — see stderr)")
    else
      DIR_REPORTS+=("$dir  $dir_updated updated, $dir_new new, $dir_current current")
    fi

    # Per-dir audit entry (install-ux-detect-dirs Plan 1) — used by the
    # migration-warning detector on subsequent runs to know that this dir was
    # previously a distribution target. Skipped when the dir didn't exist
    # (distribute_to_dir would have warned).
    if [ "$DIFF_ONLY" != "true" ] && [ -d "$dir" ]; then
      log_audit "DISTRIBUTE-DIR dir=$dir"
    fi
  done
fi

# Step 5: For --diff, we're done (no writes happened)
if [ "$DIFF_ONLY" = "true" ]; then
  echo ""
  echo "Dry run complete. No files were modified."
  exit 0
fi

# Step 6: Audit log + completion receipt
TOTAL_FILES=$((TOTAL_UPDATED + TOTAL_NEW))
log_audit "UPDATE home=$SIDEKICK_HOME $OLD_COMMIT->$NEW_COMMIT files=$TOTAL_FILES new=$TOTAL_NEW dirs=$DIRS_OK/$TOTAL_DIRS OK"

echo ""
echo "Serious Sidekick updated to $NEW_COMMIT (was $OLD_COMMIT)"
echo ""
for report in "${DIR_REPORTS[@]}"; do
  echo "  $report"
done
echo ""
echo "Audit log: $AUDIT_LOG"

if [ "$DIRS_OK" -lt "$TOTAL_DIRS" ]; then
  exit 1
fi
exit 0
