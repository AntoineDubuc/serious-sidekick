{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say -v Samantha -o /tmp/claude-say.aiff \"done\" && afplay --volume 0.05 /tmp/claude-say.aiff"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-plan-gate.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo 'status placeholder'"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "permissions": {
    "deny": []
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
